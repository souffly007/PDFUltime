<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PDFUltime" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/purple_500</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryContainer">@color/blue_100</item>
    </style>

    <style name="Theme.PDFUltime_Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#9C8CFF</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#9C8CFF</item>
        <item name="colorPrimaryContainer">#332D5C</item>
    </style>

    <style name="Theme.PDFUltime_Cyanogen" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#00BCD4</item>
        <item name="android:navigationBarColor">#050B0D</item>
        <item name="android:statusBarColor">#050B0D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#00BCD4</item>
        <item name="colorPrimaryContainer">#004D5A</item>
    </style>
</resources>
